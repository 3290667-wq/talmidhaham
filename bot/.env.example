# ===== חברותא דיגיטלית - הגדרות =====
# העתק קובץ זה לקובץ בשם .env ומלא את הערכים

# מפתח Gemini (חובה לבחנים ולשאלות) - מקבלים ב: https://aistudio.google.com/apikey
GEMINI_API_KEY=

# מודל ה-AI. flash = מהיר וזול, מספיק לחיבור שאלות ולמשוב.
GEMINI_MODEL=gemini-3.6-flash

# ===== חיבור ווצאפ דרך whatsapp-claude-bridge (Evolution API) =====
# מזהה קבוצת הווצאפ שהבוט מלווה. ריק = מצב בדיקה מקומי בטרמינל.
TALMID_GROUP_ID=

# כתובת ה-API של הברידג' (משם נשלחות ההודעות לקבוצה)
BRIDGE_URL=http://localhost:3002

# הפורט שהבוט מאזין בו להודעות שהברידג' מעביר אליו
PORT=3005
