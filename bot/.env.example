# ===== חברותא דיגיטלית - הגדרות =====
# העתק קובץ זה לקובץ בשם .env ומלא את הערכים

# מפתח Claude AI (חובה לבחנים ולשאלות) - מקבלים ב: https://console.anthropic.com
ANTHROPIC_API_KEY=

# מודל ה-AI (ברירת מחדל: האיכותי ביותר)
ANTHROPIC_MODEL=claude-opus-4-8

# ===== חיבור ווצאפ דרך Green API (לא חובה למצב בדיקה מקומי) =====
# נרשמים ב: https://green-api.com ומקבלים Instance
GREENAPI_ID_INSTANCE=
GREENAPI_API_TOKEN=

# מספר הטלפון שלך בפורמט בינלאומי בלי + (למשל 972501234567)
USER_PHONE=
